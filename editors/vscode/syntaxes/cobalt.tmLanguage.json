{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cobalt",
  "scopeName": "source.cobalt",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#intrinsics" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.cobalt",
          "match": "#.*$"
        },
        {
          "name": "comment.block.cobalt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cobalt",
          "match": "\\b(if|elif|else|while|for|in|return|match|async|await|break|continue|spawn)\\b"
        },
        {
          "name": "keyword.declaration.cobalt",
          "match": "\\b(fn|let|var|const|struct|enum|trait|impl|macro|rpc|extern)\\b"
        },
        {
          "name": "keyword.operator.logical.cobalt",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.cobalt",
          "match": "\\b(int|float|string|bool|Option|Result|Channel|Box|Rc|auto|void)\\b"
        },
        {
          "name": "entity.name.type.struct.cobalt",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn|rpc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.cobalt" },
            "2": { "name": "entity.name.function.cobalt" }
          }
        },
        {
          "name": "entity.name.function.call.cobalt",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
        }
      ]
    },
    "intrinsics": {
      "patterns": [
        {
          "name": "support.function.builtin.cobalt",
          "match": "\\b(println|print|str|len|type_name|field_count|field_names|Some|None|Ok|Err|asm)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cobalt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cobalt",
              "match": "\\\\([\"\\\\nrtv0]|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cobalt",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.cobalt",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cobalt",
          "match": "(\\+|\\-|\\*|/|%|==|!=|<=|>=|<|>|=|->|\\?\\.|\\?|\\.\\.)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cobalt",
          "match": "\\b(true|false)\\b"
        }
      ]
    }
  }
}
