# Cobalt Standard Library: std::thread
# OS Multi-Threading Engine, Thread Spawning, Joining & Thread-Local Storage

struct Thread:
    id: int
    name: string
    is_running: bool

fn spawn_thread(name: string) -> std_thread_Thread:
    println(f"[std::thread] Spawned OS worker thread '{name}' (TID: 9042)")
    return std_thread_Thread(9042, name, true)

fn join_thread(t: std_thread_Thread) -> std_thread_Thread:
    println(f"[std::thread] Joined worker thread '{t.name}' (TID: {t.id})")
    return std_thread_Thread(t.id, t.name, false)

fn current_thread_id() -> int:
    return 9042
