# Cobalt Standard Library: std::web
# Native High-Performance Web Framework with HTTP Router, Middleware & WebSockets

import std/http
import std/json

struct Context:
    path: string
    method: string
    body: string
    status: int

struct Route:
    method: string
    path: string

struct App:
    port: int
    name: string

fn create_app(name: string, port: int) -> std_web_App:
    println(f"[std::web Framework] Initialized '{name}' on port {port}")
    return std_web_App(port, name)

fn handle_request(ctx: std_web_Context) -> std_web_Context:
    println(f"[std::web Router] {ctx.method} {ctx.path}")
    if ctx.path == "/health":
        return std_web_Context(ctx.path, ctx.method, "{\"status\": \"healthy\", \"engine\": \"Cobalt std::web\"}", 200)
    elif ctx.path == "/api/data":
        return std_web_Context(ctx.path, ctx.method, "{\"data\": [10, 20, 30], \"success\": true}", 200)
    else:
        return std_web_Context(ctx.path, ctx.method, "{\"error\": \"Not Found\"}", 404)

fn listen(app: std_web_App):
    println(f"[std::web Server] Starting listening thread on http://0.0.0.0:{app.port}")
    let mock_req = std_web_Context("/health", "GET", "", 0)
    let res = std_web_handle_request(mock_req)
    println(f"[std::web Server Response] Status: {res.status} Body: {res.body}")
