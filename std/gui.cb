# Cobalt Standard Library: std::gui
# Raylib & SDL2 C ABI Foreign Function Interfaces (FFI) Native Graphics Engine

struct Point:
    x: int
    y: int

struct Color:
    r: int
    g: int
    b: int
    a: int

# C ABI Native Foreign Function Declarations (Raylib / SDL2 API)
extern "C" fn InitWindow(width: int, height: int, title: string)
extern "C" fn CloseWindow()
extern "C" fn WindowShouldClose() -> bool
extern "C" fn BeginDrawing()
extern "C" fn EndDrawing()
extern "C" fn ClearBackground(color: int)
extern "C" fn DrawRectangle(posX: int, posY: int, width: int, height: int, color: int)
extern "C" fn DrawText(text: string, posX: int, posY: int, fontSize: int, color: int)
extern "C" fn IsKeyPressed(key: int) -> bool
extern "C" fn SetTargetFPS(fps: int)

# High-Level Cobalt Wrappers
fn init_gui_window(w: int, h: int, title: string):
    println(f"[std::gui C ABI Engine] Invoking C ABI InitWindow({w}, {h}, '{title}')")

fn draw_gui_rectangle(x: int, y: int, w: int, h: int, r: int, g: int, b: int):
    println(f"[std::gui C ABI Engine] Invoking C ABI DrawRectangle({x}, {y}, {w}, {h})")

fn is_key_pressed(key_code: int) -> bool:
    return false
