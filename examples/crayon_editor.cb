# =================================================================
# Crayon Fully Interactive Nano-Style Text Editor Engine
# Written 100% in Cobalt with C FFI Raw Mode, Real-Time Key Typing,
# Visual In-Text Cursor & ANSI VT100 Hardware Cursor Positioning
# =================================================================

extern "C" fn system(cmd: string) -> int
extern "C" fn getchar() -> int

struct CrayonEditor:
    filename: string
    lines: string[]
    cursor_x: int
    cursor_y: int
    modified: bool
    status_msg: string

fn create_crayon(name: string) -> CrayonEditor:
    let ed = CrayonEditor(name, [], 0, 0, false, "Crayon Nano Active | Type to Edit | Arrow Keys | ^S: Save | ^Q: Quit")
    return ed

fn (ed: CrayonEditor) load_file(path: string):
    ed.filename = path
    let content = fs.read_file(path)
    if len(content) == 0:
        ed.lines.append("")
        ed.status_msg = f"New buffer initialized: {path}"
    else:
        var line = ""
        var i = 0
        while i < len(content):
            let ch = content[i]
            if ch == "\n":
                ed.lines.append(line)
                line = ""
            else:
                line = line + ch
            i = i + 1
        ed.lines.append(line)
        ed.status_msg = f"Loaded {len(ed.lines)} lines from {path}"
    ed.modified = false

fn (ed: CrayonEditor) save_file():
    var full_text = ""
    var idx = 0
    let total = len(ed.lines)
    for l in ed.lines:
        full_text = full_text + l
        if idx < total - 1:
            full_text = full_text + "\n"
        idx = idx + 1
    fs.write_file(ed.filename, full_text)
    ed.modified = false
    ed.status_msg = f"Wrote {len(full_text)} bytes to {ed.filename}"

fn (ed: CrayonEditor) draw_screen():
    let esc = "\x1b"
    # ANSI escape: Clear screen (\x1b[2J) & Cursor home (\x1b[H)
    println(esc + "[2J" + esc + "[H")

    var mod_tag = "[SAVED]"
    if ed.modified:
        mod_tag = "[MODIFIED]"
    println(esc + "[7m COBALT CRAYON 1.9.0 - File: " + ed.filename + " " + mod_tag + " " + esc + "[0m")
    println("=================================================================")

    var line_num = 1
    for l in ed.lines:
        var prefix = "  "
        var display_line = l
        if line_num == ed.cursor_y + 1:
            prefix = "> "
            # Render visual block cursor at cursor_x
            let line_len = len(l)
            if ed.cursor_x >= line_len:
                display_line = l + esc + "[7m " + esc + "[0m"
            else:
                let end_left = ed.cursor_x
                let left = l[0..end_left]
                let end_char = ed.cursor_x + 1
                let ch_at = l[ed.cursor_x..end_char]
                let right = l[end_char..line_len]
                display_line = left + esc + "[7m" + ch_at + esc + "[0m" + right

        println(f"{prefix}{line_num} | {display_line}")
        line_num = line_num + 1

    println("-----------------------------------------------------------------")
    let total_lines = len(ed.lines)
    let cur_line = ed.cursor_y + 1
    let cur_col = ed.cursor_x + 1
    println(f"STATUS: Ln {cur_line}/{total_lines}, Col {cur_col} | {ed.status_msg}")
    println(esc + "[7m ^S Save  ^Q Quit  ↑/↓/←/→ Move  Enter Newline  Backspace Delete " + esc + "[0m")

    # Position VT100 hardware cursor directly over active character
    let term_row = ed.cursor_y + 3
    let line_num_str = f"{cur_line}"
    let term_col = 5 + len(line_num_str) + ed.cursor_x
    print(esc + f"[{term_row};{term_col}H")

fn (ed: CrayonEditor) move_cursor_up():
    if ed.cursor_y > 0:
        ed.cursor_y = ed.cursor_y - 1
        let max_x = len(ed.lines[ed.cursor_y])
        if ed.cursor_x > max_x:
            ed.cursor_x = max_x

fn (ed: CrayonEditor) move_cursor_down():
    if ed.cursor_y < len(ed.lines) - 1:
        ed.cursor_y = ed.cursor_y + 1
        let max_x = len(ed.lines[ed.cursor_y])
        if ed.cursor_x > max_x:
            ed.cursor_x = max_x

fn (ed: CrayonEditor) move_cursor_left():
    if ed.cursor_x > 0:
        ed.cursor_x = ed.cursor_x - 1
    elif ed.cursor_y > 0:
        ed.cursor_y = ed.cursor_y - 1
        ed.cursor_x = len(ed.lines[ed.cursor_y])

fn (ed: CrayonEditor) move_cursor_right():
    let cur_len = len(ed.lines[ed.cursor_y])
    if ed.cursor_x < cur_len:
        ed.cursor_x = ed.cursor_x + 1
    elif ed.cursor_y < len(ed.lines) - 1:
        ed.cursor_y = ed.cursor_y + 1
        ed.cursor_x = 0

fn (ed: CrayonEditor) insert_char(ch: string):
    let cur_line = ed.lines[ed.cursor_y]
    if ed.cursor_x >= len(cur_line):
        ed.lines[ed.cursor_y] = cur_line + ch
    else:
        let end_left = ed.cursor_x
        let left = cur_line[0..end_left]
        let right = cur_line[ed.cursor_x..len(cur_line)]
        ed.lines[ed.cursor_y] = left + ch + right
    ed.cursor_x = ed.cursor_x + 1
    ed.modified = true
    ed.status_msg = f"Typed '{ch}'"

fn (ed: CrayonEditor) backspace():
    let cur_line = ed.lines[ed.cursor_y]
    if ed.cursor_x > 0:
        let end_left = ed.cursor_x - 1
        let left = cur_line[0..end_left]
        let right = cur_line[ed.cursor_x..len(cur_line)]
        ed.lines[ed.cursor_y] = left + right
        ed.cursor_x = ed.cursor_x - 1
        ed.modified = true
        ed.status_msg = "Backspace"
    elif ed.cursor_y > 0:
        let prev_line = ed.lines[ed.cursor_y - 1]
        let new_col = len(prev_line)
        ed.lines[ed.cursor_y - 1] = prev_line + cur_line
        
        # Remove current line
        let ed_tmp = create_crayon("")
        var i = 0
        for l in ed.lines:
            if i != ed.cursor_y:
                ed_tmp.lines.append(l)
            i = i + 1
        ed.lines = ed_tmp.lines
        ed.cursor_y = ed.cursor_y - 1
        ed.cursor_x = new_col
        ed.modified = true
        ed.status_msg = "Joined lines"

fn (ed: CrayonEditor) insert_newline():
    let cur_line = ed.lines[ed.cursor_y]
    let end_left = ed.cursor_x
    let left = cur_line[0..end_left]
    let right = cur_line[ed.cursor_x..len(cur_line)]
    
    ed.lines[ed.cursor_y] = left
    
    let ed_tmp = create_crayon("")
    var i = 0
    for l in ed.lines:
        ed_tmp.lines.append(l)
        if i == ed.cursor_y:
            ed_tmp.lines.append(right)
        i = i + 1
    ed.lines = ed_tmp.lines
    ed.cursor_y = ed.cursor_y + 1
    ed.cursor_x = 0
    ed.modified = true
    ed.status_msg = "Inserted newline"

fn main():
    let editor = create_crayon("document.cb")
    editor.load_file("document.cb")

    system("stty raw -echo opost < /dev/tty 2>/dev/null")
    defer system("stty cooked echo < /dev/tty 2>/dev/null")

    var running = true
    while running:
        editor.draw_screen()
        let k = getchar()
        
        # Exit on Ctrl+Q (17)
        if k == 17:
            running = false
        # Save on Ctrl+S (19)
        elif k == 19:
            editor.save_file()
        # Backspace (127 or 8)
        elif k == 127 or k == 8:
            editor.backspace()
        # Enter / Newline (13 or 10)
        elif k == 13 or k == 10:
            editor.insert_newline()
        # ANSI Escape Sequences (\033 [ A/B/C/D)
        elif k == 27:
            let next1 = getchar()
            if next1 == 91:
                let next2 = getchar()
                if next2 == 65:
                    editor.move_cursor_up()
                elif next2 == 66:
                    editor.move_cursor_down()
                elif next2 == 67:
                    editor.move_cursor_right()
                elif next2 == 68:
                    editor.move_cursor_left()
        # Printable ASCII Characters (32 to 126)
        elif k >= 32 and k <= 126:
            editor.insert_char(chr(k))

    let esc = "\x1b"
    println(esc + "[32m\n[Crayon Terminal] Safely exited Crayon Text Editor.\x1b[0m")
