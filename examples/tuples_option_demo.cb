# Cobalt Tuples, Multi-Value Returns & Option Unwrapping Demo

fn fetch_user_data(user_id: int) -> (int, string, bool):
    if user_id > 0:
        return (user_id, "Alice Developer", true)
    else:
        return (0, "Anonymous", false)

fn find_score(score: int) -> Option:
    if score >= 50:
        return Some(score)
    else:
        return None

fn main():
    println("=================================================================")
    println("Cobalt Tuples, Multi-Value Returns & Option Unwrapping Demo")
    println("=================================================================")

    # 1. Multi-Value Return Unpacking (let (id, name, active) = ...)
    let (id, name, active) = fetch_user_data(101)
    println(f"[Tuple Unpacking] User ID: {id} | Name: {name} | Active: {active}")

    # 2. Option Monad Unwrapping (Some / None)
    let s1 = find_score(85)
    let s2 = find_score(30)

    if s1.is_some():
        println(f"[Option Monad] Score 1 Found: {s1.unwrap()}")

    if s2.is_none():
        println("[Option Monad] Score 2 Not Found (None)")

    println("=================================================================")
