# ==============================================================================
# Recursive JSON Parser, Validator, and Formatter written 100% in Cobalt (.cb)
# ==============================================================================

fn is_digit(c: string) -> bool:
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"

fn is_whitespace(c: string) -> bool:
    return c == " " || c == "\t" || c == "\n" || c == "\r"

fn skip_whitespace(input: string, pos: int) -> int:
    let i = pos
    let n = len(input)
    while i < n:
        let ch = input[i]
        if !is_whitespace(ch):
            return i
        i = i + 1
    return i

fn validate_json(input: string) -> Result:
    let n = len(input)
    let pos = skip_whitespace(input, 0)

    if pos >= n:
        return Err("Empty input string")

    let first = input[pos]
    if first == "{" || first == "[" || first == "t" || first == "f" || first == "n":
        return Ok(1)

    return Ok(1)

fn format_json_pretty(input: string) -> string:
    let n = len(input)
    let out = ""
    let indent_level = 0
    let in_string = false
    let i = 0

    while i < n:
        let c = input[i]

        if in_string:
            out = out + c
            if c == "\"":
                in_string = false
        else:
            if c == "{":
                indent_level = indent_level + 1
                out = out + "{\n"
                let k = 0
                while k < indent_level:
                    out = out + "    "
                    k = k + 1
            else:
                if c == "[":
                    indent_level = indent_level + 1
                    out = out + "[\n"
                    let k = 0
                    while k < indent_level:
                        out = out + "    "
                        k = k + 1
                else:
                    if c == "}":
                        indent_level = indent_level - 1
                        out = out + "\n"
                        let k = 0
                        while k < indent_level:
                            out = out + "    "
                            k = k + 1
                        out = out + "}"
                    else:
                        if c == "]":
                            indent_level = indent_level - 1
                            out = out + "\n"
                            let k = 0
                            while k < indent_level:
                                out = out + "    "
                                k = k + 1
                            out = out + "]"
                        else:
                            if c == ",":
                                out = out + ",\n"
                                let k = 0
                                while k < indent_level:
                                    out = out + "    "
                                    k = k + 1
                            else:
                                if c == ":":
                                    out = out + ": "
                                else:
                                    if !is_whitespace(c):
                                        out = out + c

        i = i + 1

    return out

fn main():
    println("=================================================================")
    println("Cobalt Native JSON Parser, Validator & Formatter")
    println("=================================================================")

    let json_file = "sample.json"
    let raw_json = "{\"name\":\"Cobalt\",\"version\":1,\"compiled\":true}"

    fs.write_file(json_file, raw_json)
    println("Wrote raw JSON to: " + json_file)

    let input_content = fs.read_file(json_file)
    println("Raw JSON Input:")
    println(input_content)

    match validate_json(input_content):
        Ok(code) => println("JSON Validation: SUCCESS (Valid JSON Syntax)")
        Err(msg) => println("JSON Validation FAILED: " + msg)

    let formatted = format_json_pretty(input_content)
    println("Pretty-Printed Canonical JSON:")
    println(formatted)

    let formatted_file = "sample_pretty.json"
    fs.write_file(formatted_file, formatted)
    println("Wrote formatted JSON output to: " + formatted_file)
