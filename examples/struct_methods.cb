struct Rectangle:
    width: int
    height: int

fn (r: Rectangle) area() -> int:
    return r.width * r.height

fn (r: Rectangle) scale(factor: int):
    r.width = r.width * factor
    r.height = r.height * factor

fn main():
    println("Testing Struct Methods in Cobalt:")
    var rect = Rectangle(10, 20)

    println("Initial width:  " + str(rect.width))
    println("Initial height: " + str(rect.height))
    println("Initial area:   " + str(rect.area()))

    rect.scale(2)

    println("Scaled width:   " + str(rect.width))
    println("Scaled height:  " + str(rect.height))
    println("Scaled area:    " + str(rect.area()))
